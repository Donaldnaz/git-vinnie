# ── Shared app config ────────────────────────────────────────────────────────
APP_NAME=CloudBoard
APP_GREETING=Welcome to the Ikenna Docker Compose Workshop!

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Service ports ─────────────────────────────────────────────────────────────
WEB_PORT=5000
STUDENT_PORT=5001
STATS_PORT=5002
RESET_PORT=5003

# ── Web service — backend URLs (Docker internal DNS) ──────────────────────────
STUDENT_SERVICE_URL=http://student-service:5001
STATS_SERVICE_URL=http://stats-service:5002
RESET_SERVICE_URL=http://reset-service:5003

# ── Host port mappings ────────────────────────────────────────────────────────
WEB_HOST_PORT=8080
REDIS_COMMANDER_HOST_PORT=8081
